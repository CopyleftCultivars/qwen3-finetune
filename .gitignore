.chainlink/
.mcp.json
CHANGELOG.md

# MCQ generation pipeline: run logs, LLM judge response caches, and per-topic/
# per-batch intermediate output are regenerable scratch (rerunning the pipeline
# recreates them) — only the pipeline code, prompts, rubrics, and final merged
# data/sources/ outputs are tracked.
mcq_generation/logs/
mcq_generation/output/
mcq_generation/quality/scores/

# External reference implementation cloned locally for Phase 5 planning/work.
jacobian-lens/

# Autoresearch per-run constructed SFT datasets (prepare_dataset_v3.py output,
# named by each stream's dataset_suffix, e.g. data/train_p6lr.jsonl). Verified
# deterministic given the same source files + seed=42 + config knobs — the
# vast majority of these are byte-identical duplicates of the canonical
# data/train_v3.jsonl / data/val_v3.jsonl (every stream that doesn't override
# conversation_ratio/target_permutation_ids/synth_item_count regenerates the
# same content under a different filename). Reproducible from the already-
# committed finetune config YAML for any given run; only the canonical
# _v2/_v3/_v4-suffixed files are pinned in git as the permanent eval/training
# anchors everything else is measured against.
data/train_p[0-9]*.jsonl
data/val_p[0-9]*.jsonl
data/qmd_mcq_jspace_*.jsonl
# Regenerable cloze preflight artifacts; contamination reports remain tracked.
data/cloze_raw_*.jsonl
data/cloze_clean_*.jsonl

# Composed auxiliary lever overlays duplicate the strict v5clean base and are
# rebuilt by autoresearch/finetune.py from data/auxiliary/ immediately before a
# run. Keep the compact source streams/manifests tracked; ignore the runtime
# compositions.
data/auxiliary_levers/
data/structured_levers/

# General-instruction replay compositions are deterministic runtime overlays;
# the audited source and manifests are tracked, while ratio-specific copies
# are rebuilt by autoresearch/finetune.py.
data/general_replay/
data/sources/general_instruction/*/raw_*.jsonl

# Large per-item evaluation dumps; compact comparison reports and audits remain
# tracked under results/. These are regenerated by the scoring commands.
results/en_v5clean_anchor_*.json
results/es_transfer_*.json
results/mcq_gold_ll_*.json
results/auxiliary_validation_*.json
results/primary_p17-aux-*.json
results/structured_reflection_validation_*.json
results/primary_p18-*.json
results/mcq_gold_ll_p18-*.json
results/primary_p19-*.json
results/general_instruction_validation_*.json
results/freeform_eval_*.json
results/freeform_eval_*/
